{
  "name": "kapkoti-solution",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint worker.js public/app.js tests/*.test.js",
    "typecheck": "tsc --noEmit --allowJs --checkJs --strict false --target es2022 --module esnext --lib es2023,dom,dom.iterable worker.js public/app.js",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "typescript": "^7.0.2",
    "wrangler": "4.132.0"
  }
}
